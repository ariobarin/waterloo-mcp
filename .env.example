# Discord OAuth app, used only so Claude can sign in as you (see README)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your Discord user id; nobody else can sign in
OWNER_DISCORD_ID=

# Public HTTPS URL your reverse proxy serves, e.g. https://waterloo.example.com
PUBLIC_URL=

# Host address and port the server listens on. Your reverse proxy forwards here.
BIND_ADDR=127.0.0.1
PORT=8000

# How often to touch each service so sessions don't idle out
KEEPALIVE_MINUTES=20
