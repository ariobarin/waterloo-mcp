# Only needed when hosting over HTTP (docker compose). Local stdio use needs none of this.

# Public HTTPS URL your reverse proxy serves, e.g. https://waterloo.example.com
PUBLIC_URL=

# OAuth app that Claude signs in with: github, google or discord.
# Its redirect URL is <PUBLIC_URL>/auth/callback.
AUTH=github
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Who may sign in: user ids, usernames or emails, comma-separated
ALLOWED_USERS=

# Address and port to listen on; your reverse proxy forwards here
BIND_ADDR=127.0.0.1
PORT=8000

# How often to check in with each service so sessions don't idle out
KEEPALIVE_MINUTES=20

# 1 if the optional autologin service runs (see README, "Sign in automatically")
AUTOLOGIN=0
